[Unit]
Description=XiaoZhi to OpenClaw Realtime voice gateway
After=network-online.target openclaw-gateway.service

[Service]
Type=simple
WorkingDirectory=/home/openclaw/.openclaw/workspace-allgemein/xiaozhi-openclaw-gateway
ExecStart=/home/openclaw/.openclaw/workspace-allgemein/xiaozhi-openclaw-gateway/.venv/bin/python /home/openclaw/.openclaw/workspace-allgemein/xiaozhi-openclaw-gateway/server.py --host 0.0.0.0 --port 8765 --model gpt-live-1-codex --voice cove --session-key agent:voice:xiaozhi-realtime-v4
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
