+void Application::TickPersistentReconnect() {
+    // Only persistent-standby transports reconnect on their own. The MQTT path
+    // and older firmware behaviour are untouched.
+    if (!protocol_ || !protocol_->KeepConnectionInStandby()) return;
+    if (GetDeviceState() != kDeviceStateIdle ||
+        protocol_->IsAudioChannelOpened()) {
+        reconnect_attempts_ = 0;
+        reconnect_backoff_ticks_ = 0;
+        return;
+    }
+    if (background_reconnect_) return;
+    // 2,4,8,16,30,30,... seconds between attempts. Retrying forever is fine:
+    // the attempt is cheap and silent, and the device must recover on its own
+    // once the bridge is reachable again.
+    int wait_seconds = 2 << (reconnect_attempts_ > 4 ? 4 : reconnect_attempts_);
+    if (wait_seconds > 30) wait_seconds = 30;
+    if (++reconnect_backoff_ticks_ < wait_seconds) return;
+    reconnect_backoff_ticks_ = 0;
+    if (reconnect_attempts_ < 4) reconnect_attempts_++;
+    background_reconnect_ = true;
+    // Connect() blocks for up to ~10 s. It must not run in the main loop,
+    // otherwise a wake word during a dead bridge would be delayed.
+    const BaseType_t created = xTaskCreate(
+        [](void* arg) {
+            auto* app = static_cast<Application*>(arg);
+            const bool ok = app->protocol_ && app->protocol_->OpenAudioChannel();
+            if (ok) {
+                app->reconnect_attempts_ = 0;
+                ESP_LOGI(TAG, "Persistent transport re-established");
+            }
+            app->background_reconnect_ = false;
+            vTaskDelete(nullptr);
+        },
+        "persistent_reconnect", 8192, this, 2, nullptr);
+    if (created != pdPASS) {
+        background_reconnect_ = false;
+        ESP_LOGW(TAG, "Could not start reconnect task");
+    }
+}
