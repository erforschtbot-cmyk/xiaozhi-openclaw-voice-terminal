#!/usr/bin/env python3
"""Execute only explicitly preauthorized local Voice skill actions.

The OpenClaw Talk patch trusts invocations of this wrapper, not arbitrary skill
prose.  Consequently every action implemented here must validate all variable
input before crossing its effect boundary.
"""

from __future__ import annotations

import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


CONSOLE = "/home/openclaw/.openclaw/workspace-allgemein/scripts/azeroth-console.sh"
SERVICES = ("azeroth-authserver.service", "azeroth-worldserver.service")
ALEXA_ENDPOINT = (
    "http://192.168.178.24:8087/set/"
    "alexa2.0.Echo-Devices.G6G2MM12449402WK.Commands.textCommand"
)


def run(argv: list[str], *, timeout: int = 120) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        argv,
        check=True,
        text=True,
        capture_output=True,
        timeout=timeout,
    )


def service_states() -> list[str]:
    result = subprocess.run(
        ["systemctl", "is-active", *SERVICES],
        check=False,
        text=True,
        capture_output=True,
        timeout=15,
    )
    states = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if len(states) != 2:
        raise RuntimeError("Dienstzustand konnte nicht eindeutig geprüft werden")
    return states


def wow_server_start() -> None:
    run(["sudo", "-n", "systemctl", "start", SERVICES[0]], timeout=60)
    run(["sudo", "-n", "systemctl", "start", SERVICES[1]], timeout=120)
    states = service_states()
    if states != ["active", "active"]:
        raise RuntimeError(f"WoW-Server nicht vollständig aktiv: {states}")
    print("OK wow-server-start authserver=active worldserver=active")


def wow_server_stop() -> None:
    # Request a graceful world save/shutdown first. If the worldserver is
    # already down, the console wrapper may fail; systemd state remains the
    # authoritative condition below.
    subprocess.run(
        [CONSOLE, "server shutdown 1"],
        check=False,
        text=True,
        capture_output=True,
        timeout=20,
    )
    deadline = time.monotonic() + 120
    while time.monotonic() < deadline:
        if service_states()[1] == "inactive":
            break
        time.sleep(1)
    if service_states()[1] != "inactive":
        run(["sudo", "-n", "systemctl", "stop", SERVICES[1]], timeout=120)
    run(["sudo", "-n", "systemctl", "stop", SERVICES[0]], timeout=60)
    states = service_states()
    if states != ["inactive", "inactive"]:
        raise RuntimeError(f"WoW-Server nicht vollständig gestoppt: {states}")
    print("OK wow-server-stop authserver=inactive worldserver=inactive")


def decode_percent_payload(raw: str, *, maximum: int) -> str:
    if not raw or len(raw) > maximum * 3:
        raise ValueError("Payload fehlt oder ist zu lang")
    if not re.fullmatch(r"[A-Za-z0-9._~%+-]+", raw):
        raise ValueError("Payload enthält nicht erlaubte Zeichen")
    try:
        decoded = urllib.parse.unquote(raw, encoding="utf-8", errors="strict")
    except UnicodeDecodeError as error:
        raise ValueError("Payload ist kein gültiges UTF-8") from error
    if not decoded.strip() or len(decoded) > maximum or any(ord(ch) < 32 for ch in decoded):
        raise ValueError("Dekodierter Payload ist ungültig")
    return decoded


def alexa_smart_home(raw: str) -> None:
    command = decode_percent_payload(raw, maximum=500)
    if command.casefold().startswith("alexa"):
        raise ValueError("Befehl darf nicht mit Alexa beginnen")
    url = f"{ALEXA_ENDPOINT}?value={urllib.parse.quote(command, safe='')}"
    request = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            status = response.status
    except urllib.error.HTTPError as error:
        status = error.code
    if status != 200:
        raise RuntimeError(f"ioBroker Simple API antwortete mit HTTP {status}")
    print("OK alexa-smart-home http=200")


SAFE_GM_PATTERNS = (
    re.compile(r"additem Priestilia [1-9][0-9]* [1-9][0-9]*"),
    re.compile(r"tele name Priestilia [A-Za-z0-9_$-]+"),
    re.compile(r"recall Priestilia"),
    re.compile(r"saveall"),
)


def azeroth_gm_safe(raw: str) -> None:
    command = decode_percent_payload(raw, maximum=300)
    if not any(pattern.fullmatch(command) for pattern in SAFE_GM_PATTERNS):
        raise ValueError("GM-Befehl ist nicht als reversible Voice-Aktion freigegeben")
    result = run([CONSOLE, command], timeout=30)
    output = (result.stdout or result.stderr).strip()
    if not output:
        raise RuntimeError("SOAP-Aufruf lieferte kein Ergebnis")
    print(output)


def self_test() -> None:
    assert decode_percent_payload("Licht%20an", maximum=20) == "Licht an"
    for rejected in ("", "x;id", "x%0Aid", "x" * 61):
        try:
            decode_percent_payload(rejected, maximum=20)
        except ValueError:
            pass
        else:
            raise AssertionError(f"unsafe payload accepted: {rejected!r}")
    assert any(p.fullmatch("additem Priestilia 123 2") for p in SAFE_GM_PATTERNS)
    assert not any(p.fullmatch("additem Priestilia 123 -2") for p in SAFE_GM_PATTERNS)
    assert not any(p.fullmatch("server restart 1") for p in SAFE_GM_PATTERNS)
    assert not any(p.fullmatch("kick Priestilia test") for p in SAFE_GM_PATTERNS)
    print("Voice skill action self-test passed")


def main(argv: list[str]) -> int:
    if argv == ["--self-test"]:
        self_test()
        return 0
    if not argv:
        raise ValueError("Aktions-ID fehlt")
    action, *args = argv
    if action == "wow-server-start" and not args:
        wow_server_start()
    elif action == "wow-server-stop" and not args:
        wow_server_stop()
    elif action == "alexa-smart-home" and len(args) == 1:
        alexa_smart_home(args[0])
    elif action == "azeroth-gm-safe" and len(args) == 1:
        azeroth_gm_safe(args[0])
    else:
        raise ValueError("Unbekannte oder ungültig parametrisierte Voice-Aktion")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"BLOCKED: {error}", file=sys.stderr)
        raise SystemExit(2)
